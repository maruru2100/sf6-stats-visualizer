# DB設定
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=sf6_stats

# アプリ用設定
DATABASE_URL=postgresql://DBユーザー名:DBのパスワード@db:5432/sf6_stats
TARGET_PLAYER_ID=あなたのIDをここに入力
MY_PLAYER_NAME=あなたの名前をここに入力

# DiscordBot設定
DISCORD_BOT_TOKEN=DiscordのTokenを設定
DISCORD_WEBHOOK_URL=DiscordのWebhookのURLを設定

# 共通ログイン情報（任意設定）
SHARED_LOGIN_ID=身内で使いたいログインID
SHARED_LOGIN_PW=身内で使いたいログインパスワード

# --- Cloudflare Tunnel 設定 ---
# 設定の有無で自動的にモードが切り替わります（コードやdocker-compose.ymlの編集は不要）。
#   お試しURL（クイックトンネル）の方 : 両方とも空欄のままにしてください。
#   独自ドメイン運用の方               : 両方とも設定してください（片方だけだとエラーになります）。
# 公開URL（末尾のスラッシュは不要）。例: https://sf6-metabase.あなたのドメイン
PUBLIC_URL_OVERRIDE=
# Cloudflare ダッシュボードで発行したトンネルトークン
CF_TUNNEL_TOKEN=

# --- REST API 設定（任意） ---
# 設定すると /health 以外で X-API-Key ヘッダが必須になります。空欄なら認証なし。
API_KEY=

# --- スケジューラ設定（任意） ---
# 0 を指定すると定期巡回を無効化します。空欄/1 なら有効。
SCHEDULER_ENABLED=1